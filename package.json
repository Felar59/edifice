{
  "name": "edifice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Le Musée Impossible — moteur d'espace cousu (prototype de couture)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "torture": "node scripts/torture.mjs",
    "physique": "cargo build --release --manifest-path physique/Cargo.toml --target wasm32-unknown-unknown && node -e \"require('fs').copyFileSync('physique/target/wasm32-unknown-unknown/release/edifice_physique.wasm','src/player/physique.wasm')\""
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
